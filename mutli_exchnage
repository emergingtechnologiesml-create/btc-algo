def harmonize_exchanges(exchange_dfs: dict):
    # Rename columns to standard OHLCV schema
    normalized = {}
    for name, df in exchange_dfs.items():
        df = df.rename(columns={
            "Open": "open", "High": "high", "Low": "low",
            "Close": "close", "Volume": "volume"
        })
        df = df[["open", "high", "low", "close", "volume"]]
        df["exchange"] = name
        normalized[name] = df

    # Merge & sort into a unified harmonized feed
    merged = pd.concat(normalized.values()).sort_index()

    print(f"[HARMONIZER] merged candles: {len(merged)} from {len(exchange_dfs)} exchanges")
    return merged
